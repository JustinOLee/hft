# Copy to secrets/kalshi.env and fill in. secrets/ is gitignored: this repo is
# public, so the real file must never be committed.
#
# Get a key: log in at https://demo.kalshi.co (demo, fake money) or
# https://kalshi.com (prod), go to Account/Profile -> API Keys, create an
# Ed25519 key, and save the private key file it gives you into secrets/.

# demo or prod
KALSHI_ENV=demo
# The key ID shown next to the key on Kalshi's site
KALSHI_KEY_ID=
# Path to the private key file you downloaded
KALSHI_KEY_FILE=secrets/kalshi-demo.pem
